<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: captures, and the flag that unlocks capture mode (capture_gate), are neither backed up to the cloud nor moved to a new phone -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="captures/" />
        <exclude domain="file" path="capture-reports/" />
        <exclude domain="sharedpref" path="capture_gate.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="captures/" />
        <exclude domain="file" path="capture-reports/" />
        <exclude domain="sharedpref" path="capture_gate.xml" />
    </device-transfer>
</data-extraction-rules>
