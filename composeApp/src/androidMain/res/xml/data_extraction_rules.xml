<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: captures, the flag that unlocks capture mode (capture_gate), the emulated document the user entered
     (passport) and the read history are neither backed up to the cloud nor moved to a new phone. Only the app settings are -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="captures/" />
        <exclude domain="file" path="capture-reports/" />
        <exclude domain="sharedpref" path="capture_gate.xml" />
        <exclude domain="sharedpref" path="passport.xml" />
        <exclude domain="sharedpref" path="read_history.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="captures/" />
        <exclude domain="file" path="capture-reports/" />
        <exclude domain="sharedpref" path="capture_gate.xml" />
        <exclude domain="sharedpref" path="passport.xml" />
        <exclude domain="sharedpref" path="read_history.xml" />
    </device-transfer>
</data-extraction-rules>
