    "ApplicationObservation": {
      "description": "The answer to SELECT of the eMRTD application (AID A0000002471001).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectStatusWord"
      ],
      "properties": {
        "selectStatusWord": {
          "$ref": "#/$defs/StatusWord"
        },
        "responseSize": {
          "description": "The length of the response data in 16-byte buckets.",
          "oneOf": [
            {
              "$ref": "#/$defs/ProbeSizeRange"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "BacCommandObservation": {
      "description": "The status words of the commands BAC starts with, before any authentication. Null is no answer; the challenge is never stored.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "getChallenge": {
          "description": "GET CHALLENGE with Le 08.",
          "oneOf": [
            {
              "$ref": "#/$defs/StatusWord"
            },
            {
              "type": "null"
            }
          ]
        },
        "externalAuthenticate": {
          "description": "EXTERNAL AUTHENTICATE with 40 bytes of zeros and no GET CHALLENGE before it.",
          "oneOf": [
            {
              "$ref": "#/$defs/StatusWord"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ProbeSizeRange": {
      "description": "A 16-byte bucket (Redaction.PROBE_BUCKET) for the response of a probe step and of the application SELECT: minBytes a multiple of 16, maxBytes = minBytes + 15. Probes read only the public EF.CardAccess, so the finer bucket is no quasi-identifier. The maxBytes relation is checked by the ingest lint.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minBytes",
        "maxBytes"
      ],
      "properties": {
        "minBytes": {
          "type": "integer",
          "minimum": 0,
          "multipleOf": 16
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 15
        }
      }
    }
